{
  "manifest_version": 3,
  "name": "CipherGap",
  "version": "1.2.1",
  "description": "Client-side encrypted messages and files for Bale Web.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.bale.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.bale.ai/*"
      ],
      "js": [
        "content/main_world_bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.bale.ai/*"
      ],
      "js": [
        "share/namespace.js",
        "share/config.js",
        "share/translations.js",
        "share/i18n.js",
        "share/encoding.js",
        "share/crypto.js",
        "share/file_crypto.js",
        "share/dh_crypto.js",
        "share/protocol.js",
        "share/messenger_adapter.js",
        "content/utils.js",
        "content/storage.js",
        "content/key_exchange.js",
        "content/bale.js",
        "content/messenger.js",
        "content/observer.js",
        "content/content.js"
      ]
    }
  ],
  "action": {
    "default_title": "CipherGap",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    },
    "default_popup": "popup/popup.html"
  }
}
